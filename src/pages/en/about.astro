---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SilhouetteBust from '../../components/SilhouetteBust.astro';
import { career, highlightsEn, profile } from '../../data/profile';

const MAGENTA = '#E5007F';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.romaji,
  description: profile.roleEn,
  url: new URL('/en/about/', Astro.site).href,
  sameAs: profile.links.map((l) => l.url),
};
---

<BaseLayout
  title="About | akari.log"
  description={`${profile.name} (${profile.romaji}): ${profile.roleEn}`}
  lang="en"
  alternate={{ lang: 'ja', href: '/about/' }}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <main>
    <section class="mx-auto max-w-5xl overflow-x-clip px-6 pt-12">
      <h1 class="font-display text-5xl">About</h1>
      <div class="mt-3 mb-12 h-3 w-28 -skew-x-12" style={`background:${MAGENTA}`}></div>

      <div class="flex flex-col sm:flex-row sm:items-end sm:gap-12">
        <div class="enter-from-right order-2 w-44 shrink-0 self-center sm:order-none sm:w-64 sm:self-auto lg:w-80">
          <SilhouetteBust color={MAGENTA} crop={540} class="block w-full translate-y-14" />
        </div>

        <div class="enter-from-left order-1 min-w-0 flex-1 pb-14 sm:order-none">
          <p class="font-display text-3xl">
            {profile.name}
            <span class="ml-2 font-mono text-sm font-normal text-neutral-500">
              / {profile.romaji}
            </span>
          </p>

          <p class="mt-8 flex flex-wrap gap-2">
            {
              profile.verbsEn.map((v) => (
                <span class="-skew-x-6 bg-neutral-900 px-3 py-1 text-sm font-bold text-white">
                  {v}
                </span>
              ))
            }
          </p>

          <p class="mt-8 leading-relaxed font-bold">{profile.roleEn}</p>
          {
            profile.bioEn.map((paragraph) => (
              <p class="mt-4 leading-loose text-neutral-700">{paragraph}</p>
            ))
          }

          <dl class="mt-10 space-y-4">
            {
              [...profile.factsEn, ...highlightsEn].map((f) => (
                <div class="flex items-baseline gap-4">
                  <dt class="flex w-28 shrink-0 items-center gap-2 font-mono text-xs font-bold text-neutral-500">
                    <span
                      class="inline-block h-3 w-3.5 -skew-x-12"
                      style={`background:${MAGENTA}`}
                    />
                    {f.label}
                  </dt>
                  <dd class="text-sm">{f.value}</dd>
                </div>
              ))
            }
          </dl>

          <p class="mt-10 flex flex-wrap gap-3">
            {
              profile.links.map((l) => (
                <a
                  href={l.url}
                  target="_blank"
                  rel="noopener"
                  class="border-2 border-neutral-900 px-4 py-1.5 font-mono text-sm font-bold transition-colors hover:bg-neutral-900 hover:text-white"
                >
                  {l.label}
                </a>
              ))
            }
          </p>
        </div>
      </div>
    </section>

    <section class="theme-fixed text-white" style={`background:${MAGENTA}`}>
      <div class="mx-auto max-w-5xl px-6 py-12 sm:py-16">
        <h2 class="font-display mb-12 text-4xl sm:text-5xl">Career</h2>

        {
          career.map((c) => (
            <div class="flex flex-col gap-1 sm:flex-row sm:gap-7">
              <p class="w-32 shrink-0 pt-0.5 font-mono text-sm">
                {c.period}
              </p>
              <div class="flex-1 border-l-2 border-white/30 pb-10 pl-6">
                <h3 class="flex flex-wrap items-center gap-2">
                  <span class="inline-block h-4 w-5 -skew-x-12 bg-white" />
                  <span class="font-display text-lg">「{c.verbsEn[0]}」</span>
                  {c.verbsEn.slice(1).map((v) => (
                    <span
                      class="bg-white px-2 py-0.5 font-mono text-xs font-bold"
                      style={`color:${MAGENTA}`}
                    >
                      × {v}
                    </span>
                  ))}
                  {c.current && (
                    <span class="bg-neutral-900 px-2 py-0.5 font-mono text-xs font-bold text-white">
                      NOW
                    </span>
                  )}
                </h3>
                <p class="mt-3 text-sm leading-relaxed font-bold">{c.summaryEn}</p>
                <ul class="mt-3 space-y-1 text-sm">
                  {c.detailsEn.map((d) => (
                    <li>- {d}</li>
                  ))}
                </ul>
                <p class="mt-3 flex flex-wrap gap-2 font-mono text-xs">
                  {c.tags.map((t) => (
                    <span class="border border-white/80 px-2 py-0.5">{t}</span>
                  ))}
                </p>
              </div>
            </div>
          ))
        }

        <p class="font-mono text-sm font-bold">
          <a href="/en/career/" class="underline">→ Skills (the hand of cards)</a>
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
