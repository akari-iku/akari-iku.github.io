---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile, skillGroups } from '../../data/profile';

const ORANGE = '#FF6B00';
---

<BaseLayout
  title="Career | akari.log"
  description={`The hand of cards of ${profile.romaji}: Skills`}
  lang="en"
  alternate={{ lang: 'ja', href: '/career/' }}
>
  <main class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="font-display text-5xl">Career</h1>
    <div class="mt-3 mb-4 h-3 w-28 -skew-x-12" style={`background:${ORANGE}`}></div>
    <p class="mb-12 text-sm text-neutral-600">
      The detailed data: the hand of cards. The career timeline lives on
      <a href="/en/about/" class="underline">About</a>.
    </p>

    <section>
      <h2 class="flex items-center gap-3">
        <span class="inline-block h-6 w-8 -skew-x-12" style={`background:${ORANGE}`}
        ></span>
        <span class="font-display bg-neutral-900 px-4 py-1 text-white">Skills</span>
      </h2>
      <p class="mt-3 font-mono text-xs text-neutral-500">
        The stack is a hand of cards: I play whichever the problem calls for, and draw
        what's missing.
      </p>
      <div class="mt-6 space-y-5">
        {
          skillGroups.map((g) => (
            <div>
              <p class="font-mono text-xs font-bold text-neutral-500">
                {g.labelEn}
                {g.noteEn && <span class="ml-2 font-normal">: {g.noteEn}</span>}
              </p>
              <p class="mt-2 flex flex-wrap gap-2">
                {(g.itemsEn ?? g.items).map((s) => (
                  <span class="border border-neutral-900 px-3 py-1 font-mono text-xs">
                    {s}
                  </span>
                ))}
              </p>
            </div>
          ))
        }
        <p>
          <span class="border border-dashed border-neutral-400 px-3 py-1 font-mono text-xs text-neutral-500">
            and more...
          </span>
        </p>
      </div>
    </section>

    <p class="mt-16 font-mono text-sm">
      <a href="/en/about/" class="underline">← About (profile and timeline)</a>
    </p>
  </main>
</BaseLayout>
