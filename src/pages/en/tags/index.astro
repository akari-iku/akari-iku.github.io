---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { tagCounts } from '../../../lib/tags';
import { accentFor, ACCENT } from '../../../lib/tag-colors';

const tags = await tagCounts('en');
---

<BaseLayout
  title="Tags | akari.log"
  description="All tags on akari.log"
  lang="en"
  alternate={{ lang: 'ja', href: '/tags/' }}
>
  <main class="mx-auto max-w-5xl px-6 py-12">
    <h1 class="font-display text-5xl">Tags</h1>
    <div class="mt-3 mb-10 h-3 w-28 -skew-x-12" style={`background:${ACCENT.green}`}></div>

    <div class="flex flex-wrap gap-3 font-mono text-sm font-bold">
      {
        tags.map(({ tag, count }) => (
          <a
            href={`/en/tags/${tag}/`}
            class="flex items-center gap-2 border-2 border-neutral-900 px-3 py-1.5 hover:bg-neutral-900 hover:text-white"
          >
            <span
              class="inline-block h-3 w-4 -skew-x-12"
              style={`background:${accentFor([tag])}`}
            />
            {tag}
            <span class="text-neutral-500">{count}</span>
          </a>
        ))
      }
    </div>
  </main>
</BaseLayout>
