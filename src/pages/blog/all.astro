---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const YELLOW = '#FFD400';

const entries = (await getCollection('blog', (p) => p.data.lang === 'ja'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => {
    const date = post.data.date.toISOString().slice(0, 10);
    return {
      date,
      year: date.slice(0, 4),
      title: post.data.title,
      href: `/blog/${post.id.replace(/^ja\//, '')}/`,
    };
  });

// Group in one pass; Map insertion order keeps the newest-first order of entries.
const byYear = new Map<string, typeof entries>();
for (const entry of entries) {
  const group = byYear.get(entry.year) ?? [];
  group.push(entry);
  byYear.set(entry.year, group);
}
const years = [...byYear].map(([year, posts]) => ({ year, posts }));
---

<BaseLayout
  title="Index | akari.log"
  description="akari.log 全記事の索引（年別・新しい順）"
  lang="ja"
  alternate={{ lang: 'en', href: '/en/blog/all/' }}
>
  <main class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="font-display text-5xl">Index</h1>
    <div class="mt-3 mb-4 h-3 w-28 -skew-x-12" style={`background:${YELLOW}`}></div>
    <p class="mb-10 text-sm text-neutral-600">全記事の索引。年別・新しい順。</p>

    {
      years.map(({ year, posts }) => (
        <section class="mt-10 first:mt-0">
          <h2 id={year} class="flex items-baseline gap-3">
            <span class="font-display text-3xl">{year}</span>
            <span class="font-mono text-xs text-neutral-500">— {posts.length}</span>
          </h2>
          <ul class="mt-4 space-y-2">
            {posts.map((e) => (
              <li class="grid grid-cols-[auto_1fr] items-baseline gap-x-4">
                <time class="font-mono text-xs text-neutral-500" datetime={e.date}>
                  {e.date}
                </time>
                <a href={e.href} class="font-databook leading-snug font-bold hover:underline">
                  {e.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <p class="mt-16 font-mono text-sm">
      <a href="/blog/" class="underline">← Blog</a>
    </p>
  </main>
</BaseLayout>
