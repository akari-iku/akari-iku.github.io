---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  lang?: 'ja' | 'en';
  ogType?: 'website' | 'article';
  ogImage?: string;
  alternate?: { lang: 'ja' | 'en'; href: string } | null;
}

const {
  title,
  description = '',
  lang = 'ja',
  ogType = 'website',
  ogImage = '/og/site.png',
  alternate = null,
} = Astro.props;

const fontsHref =
  'https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Dela+Gothic+One&family=JetBrains+Mono:wght@400;700&family=Noto+Sans+JP:wght@400;700;900&family=Noto+Serif+JP:wght@500;700&display=swap';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const rssHref = lang === 'en' ? '/en/rss.xml' : '/rss.xml';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // apply stored theme before first paint (no white flash for dark users)
      try {
        if (localStorage.getItem('theme') === 'dark')
          document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="max-snippet:-1, max-image-preview:large" />
    {
      alternate && (
        <>
          <link rel="alternate" hreflang={lang} href={canonical} />
          <link
            rel="alternate"
            hreflang={alternate.lang}
            href={new URL(alternate.href, Astro.site).href}
          />
        </>
      )
    }
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="akari.log" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="akari.log" href={rssHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- async font CSS: render with fallbacks first, swap in webfonts on arrival -->
    <link rel="stylesheet" href={fontsHref} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={fontsHref} />
    </noscript>
    <Analytics />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-white text-neutral-900">
    <a href="#main" class="skip-link">{lang === 'en' ? 'Skip to content' : '本文へスキップ'}</a>
    <Header />
    <div id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </div>
    <Footer />
  </body>
</html>
